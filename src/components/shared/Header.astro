---
interface Props {
  brandName?: string;
  brandEdit?: Record<string, string>;
  homeHref?: string;
  plateHref?: string;
  typesHref?: string;
  readingsHref?: string;
  questionsHref?: string;
  chartHref?: string;
}

const {
  brandName = "Nine Centres",
  brandEdit = {},
  homeHref = "#top",
  plateHref = "#plate",
  typesHref = "#types",
  readingsHref = "#readings",
  questionsHref = "#faq",
  chartHref = "#chart",
} = Astro.props;
---

<header class="hd-header" data-hd-header>
  <a href={homeHref} class="brand-link" data-brand-link {...brandEdit}>
    {brandName}
  </a>
  <nav class="nav-links" aria-label="Primary Navigation">
    <a href={plateHref} class="nav-link">Plate</a>
    <a href={typesHref} class="nav-link">Types</a>
    <a href={readingsHref} class="nav-link">Readings</a>
    <a href={questionsHref} class="nav-link">Questions</a>
  </nav>
  <a href={chartHref} class="cta-btn" data-cta-btn>
    Free bodygraph
  </a>
</header>

<style>
  .hd-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #1230C8;
    color: #F5F1E8;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 32px;
    border-bottom: 1.5px solid #0A1030;
  }

  .brand-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
    color: #F5F1E8;
    text-decoration: none;
  }

  .brand-link:hover {
    color: #FF6B4A;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #B9C4FF;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: #F5F1E8;
  }

  .cta-btn {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: #FF6B4A;
    color: #0A1030;
    padding: 10px 18px;
    border: 1.5px solid #0A1030;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .cta-btn:hover {
    background: #F5F1E8;
    color: #0A1030;
  }

  @media (max-width: 640px) {
    .hd-header {
      padding: 12px 20px;
    }
    .nav-links {
      gap: 16px;
    }
  }
</style>
